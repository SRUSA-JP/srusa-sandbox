{
  "name": "srusa-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SRUSA の Minecraft サーバー統計と相関図を 1 つにまとめたビューア（React + TypeScript + Vite + Tailwind CSS）",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite --host",
    "build": "npm run typecheck && npm run lint && npm run test:ui && npm run check:contrast && npm run check:design && npm run check:layout && npm run check:map && npm run check:world-map && vite build",
    "preview": "vite preview",
    "deploy:preview": "npm run build && npx netlify-cli deploy --dir=dist --alias preview",
    "deplpy:preview": "npm run deploy:preview",
    "refresh:data": "npm run update:data --",
    "refresh:data:local": "npm run sync:data --",
    "refresh:live": "node scripts/refresh-live-data.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "vite build --ssr scripts/check-ui-render.tsx --outDir node_modules/.cache/ui-render --emptyOutDir false && node node_modules/.cache/ui-render/check-ui-render.js",
    "check:contrast": "esbuild --bundle --format=esm --platform=node --log-level=error scripts/check-contrast.ts --outfile=node_modules/.cache/check-contrast.mjs && node node_modules/.cache/check-contrast.mjs",
    "check:design": "esbuild --bundle --format=esm --platform=node --log-level=error scripts/check-design.ts --outfile=node_modules/.cache/check-design.mjs && node node_modules/.cache/check-design.mjs",
    "check:layout": "esbuild --bundle --format=esm --platform=node --log-level=error scripts/check-layout.ts --outfile=node_modules/.cache/check-layout.mjs && node node_modules/.cache/check-layout.mjs",
    "check:map": "esbuild --bundle --format=esm --platform=node --log-level=error scripts/check-map.ts --outfile=node_modules/.cache/check-map.mjs && node node_modules/.cache/check-map.mjs",
    "check:world-map": "esbuild --bundle --format=esm --platform=node --log-level=error scripts/check-world-map.ts --outfile=node_modules/.cache/check-world-map.mjs && node node_modules/.cache/check-world-map.mjs",
    "audit:bluemap": "node scripts/audit-bluemap-source.mjs",
    "lint": "eslint .",
    "update:data": "node scripts/update-data.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "build:minecraft-stats": "node scripts/build-minecraft-stats.mjs",
    "build:item-rankings": "node scripts/build-featured-used-items.mjs",
    "build:inventory-assets": "node scripts/build-player-inventory-assets.mjs",
    "build:player-daily": "node scripts/build-player-daily-summary.mjs",
    "build:play-days": "node scripts/build-play-days.mjs",
    "build:chunk-world-map": "esbuild --bundle --format=esm --platform=node --log-level=error scripts/build-chunk-world-map.ts --outfile=node_modules/.cache/build-chunk-world-map.mjs && node node_modules/.cache/build-chunk-world-map.mjs",
    "build:world-map": "esbuild --bundle --format=esm --platform=node --log-level=error scripts/build-world-map.ts --outfile=node_modules/.cache/build-world-map.mjs && node node_modules/.cache/build-world-map.mjs",
    "check:viewport": "esbuild --bundle --format=esm --platform=node --log-level=error --packages=external scripts/check-viewport.ts --outfile=node_modules/.cache/check-viewport.mjs && node node_modules/.cache/check-viewport.mjs",
    "build:icons": "esbuild --bundle --format=esm --platform=node --log-level=error scripts/build-app-icons.ts --outfile=node_modules/.cache/build-app-icons.mjs && node node_modules/.cache/build-app-icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.9"
  }
}
